{"anon_id": "NB-001", "direction": 2, "claims": 2, "timing": 1, "total": 5, "pass": true, "notes": "病位头胸心胃与不可治、终死均被症状与8月14日之死证实；大师未给具体死期，无时点可核（中性记 1）。"}
{"anon_id": "NB-002", "direction": 2, "claims": 2, "timing": 2, "total": 6, "pass": true, "notes": "脾风胆腹疾与头扰不安诸症皆实，断十至十二日死而第十二日果死，三项全合。"}
{"anon_id": "NB-003", "direction": 2, "claims": 2, "timing": 1, "total": 5, "pass": true, "notes": "婚姻果经月亮所象之人居间促成而双方满意；断语只言骤成而结局无日期，无时点可核（中性记 1）。"}
{"anon_id": "NB-004", "direction": 2, "claims": 2, "timing": 1, "total": 5, "pass": true, "notes": "果以斩首之较尊贵死法代绞刑，死法断语合；结局仅记1月10日而包内无起算日，六七周期限只能部分核对。"}
{"anon_id": "NB-005", "direction": 1, "claims": 1, "timing": 1, "total": 3, "pass": false, "notes": "鲁珀特未胜埃塞克斯且未被杀大体合，然断言终入我方 custody 与实际获释逃脱有出入；无具体应期，无时点可核（中性记 1）。"}
{"anon_id": "NB-006", "direction": 2, "claims": 2, "timing": 2, "total": 6, "pass": true, "notes": "爱尔兰援军助而生衅不久被切断、王后约三四月后会合且4月于诺丁汉附近损兵，事件与时点俱合。"}
{"anon_id": "NB-007", "direction": 2, "claims": 2, "timing": 1, "total": 5, "pass": true, "notes": "三周内果得职且所托假友被揭穿、形貌亦合；大师未预告得职日期，无时点可核（中性记 1）。"}
{"anon_id": "NB-008", "direction": 2, "claims": 2, "timing": 1, "total": 5, "pass": true, "notes": "马果西行后自行归家，方向与归还合；断一二日归而实际三日归，应期迟一日为部分对齐。"}
{"anon_id": "NB-009", "direction": 1, "claims": 1, "timing": 1, "total": 3, "pass": false, "notes": "断非巫蛊而为肾与秘处之隐性女病，结局仅记改医三周而愈，具体病因部位未被结局直接证实；无应期，无时点可核（中性记 1）。"}
{"anon_id": "NB-010", "direction": 2, "claims": 2, "timing": 2, "total": 6, "pass": true, "notes": "犯人果东行、潜伏一夜、周五得信、周日被有权者捕获，方位方式与六七日内得信俱合。"}
{"anon_id": "NB-011", "direction": 2, "claims": 1, "timing": 1, "total": 4, "pass": true, "notes": "伯爵果大败尽失军械仅得保兵，损败大势合；断语中计谋被卖一项结局未载；无具体应期，无时点可核（中性记 1）。"}
{"anon_id": "NB-012", "direction": 2, "claims": 2, "timing": 2, "total": 6, "pass": true, "notes": "寅年果遇富翁资助读书、午年果登榜得官，际遇与金榜及年份俱合。"}
{"anon_id": "NB-013", "direction": 0, "claims": 0, "timing": 1, "total": 1, "pass": false, "notes": "断农生可度、人丁六畜丰盛，现实子年蝗尽、阖家与六畜皆瘟，方向与断语全反；大师未给子年应期，无时点可核（中性记 1）。"}
{"anon_id": "NB-014", "direction": 2, "claims": 2, "timing": 1, "total": 5, "pass": true, "notes": "果以援例纳赀由财入官、巳年初任县令，以财变官合；大师明言不敢指年月，无时点可核（中性记 1）。"}
{"anon_id": "NB-015", "direction": 1, "claims": 1, "timing": 2, "total": 4, "pass": true, "notes": "午年果得保举为官合富贵之向，然断中举而实际非科甲出身，等级与方式错位；午年时点合。"}
{"anon_id": "NB-016", "direction": 2, "claims": 1, "timing": 2, "total": 5, "pass": true, "notes": "果巳月生恶疮、酉月而卒，不测之祸合；大师未断具体疮死之症，断语仅部分具体；五月与酉月应期合。"}
{"anon_id": "NB-017", "direction": 2, "claims": 2, "timing": 2, "total": 6, "pass": true, "notes": "巳年援例官至府佐、未年出仕、戌年升任，与断语逐年全合。"}
{"anon_id": "NB-018", "direction": 2, "claims": 1, "timing": 1, "total": 4, "pass": true, "notes": "断必有官，果随营立功五年内官至元戎将军；断语仅言有官无具体官阶细节；无应期，无时点可核（中性记 1）。"}
{"anon_id": "NB-019", "direction": 1, "claims": 1, "timing": 1, "total": 3, "pass": false, "notes": "终有死厄之向合，然断亥年不利而实际卒于戌年，年尺度对而坐标偏一年，为部分对齐。"}
{"anon_id": "NB-020", "direction": 2, "claims": 1, "timing": 2, "total": 5, "pass": true, "notes": "断须防卯岁，果卒于卯年；断语仅言防而未明言死症，故关键断语部分具体；卯年应期合。"}
{"anon_id": "NB-021", "direction": 2, "claims": 1, "timing": 2, "total": 5, "pass": true, "notes": "断本日辰时前后有危亡、留之可避，是晨果有四船江心覆没尸满江，时窗合；断语未明言船覆之形，故部分具体。"}
{"anon_id": "NB-022", "direction": 2, "claims": 2, "timing": 2, "total": 6, "pass": true, "notes": "断六七月防土木之厄、往东可避，果七月往东后地震房塌伤人而独免，厄种与月份俱合。"}
{"anon_id": "NB-023", "direction": 1, "claims": 1, "timing": 1, "total": 3, "pass": false, "notes": "结局仅以反问言二人欲害、外出免害，从者与避祸仅部分得实；未、七月露之说结局无时点可核（中性记 1）。"}
{"anon_id": "NB-024", "direction": 2, "claims": 2, "timing": 1, "total": 5, "pass": true, "notes": "果议绞罪后蒙驳回改活罪，刑名与改刑俱合；无应期，无时点可核（中性记 1）。"}
{"anon_id": "NB-025", "direction": 2, "claims": 2, "timing": 2, "total": 6, "pass": true, "notes": "数十年后父果甚健、母果终于子年，长寿与防子年两卦分断俱合。"}
{"anon_id": "NB-026", "direction": 2, "claims": 1, "timing": 1, "total": 4, "pass": true, "notes": "断父不许长年且无长月，果同年冬至日而终，短寿之向合；断语无具体死因，时点仅年内尺度部分对齐。"}
{"anon_id": "NB-027", "direction": 2, "claims": 2, "timing": 1, "total": 5, "pass": true, "notes": "果有属猴之弟独登一第、余兄弟别业，属猴得济之具体断语合；无应期，无时点可核（中性记 1）。"}
{"anon_id": "NB-028", "direction": 2, "claims": 2, "timing": 1, "total": 5, "pass": true, "notes": "正妻果贤而无妒、夫妻偕老至八旬余，妻性与偕老俱合；无应期，无时点可核（中性记 1）。"}
{"anon_id": "NB-029", "direction": 2, "claims": 2, "timing": 2, "total": 6, "pass": true, "notes": "失散远方之子果于次年归来父子相逢，归子之事与明岁应期合。"}
{"anon_id": "NB-030", "direction": 2, "claims": 1, "timing": 1, "total": 4, "pass": true, "notes": "断吉兆后果得成名；断语仅泛言吉与成名无具体名位；无应期，无时点可核（中性记 1）。"}
{"anon_id": "NB-031", "direction": 0, "claims": 0, "timing": 1, "total": 1, "pass": false, "notes": "明断此差不得，实际三日内反得差遣，主断被证伪；三日得差系事后之岂知而非预断，无时点可核（中性记 1）。"}
{"anon_id": "NB-032", "direction": 2, "claims": 2, "timing": 2, "total": 6, "pass": true, "notes": "断今年冬月必升，果升于冬月，升迁与月份俱合。"}
{"anon_id": "NB-033", "direction": 2, "claims": 2, "timing": 2, "total": 6, "pass": true, "notes": "断自身无妨须防孝服八九月见，果八月丁艰，孝服之事与月份俱合。"}
{"anon_id": "NB-034", "direction": 2, "claims": 2, "timing": 2, "total": 6, "pass": true, "notes": "断七八月功名坏，果八月削职，坏名之事与月份俱合。"}
{"anon_id": "NB-035", "direction": 2, "claims": 2, "timing": 2, "total": 6, "pass": true, "notes": "断寅年以原品起用，果应于寅年，复职之事与年份俱合。"}
{"anon_id": "NB-036", "direction": 2, "claims": 1, "timing": 2, "total": 5, "pass": true, "notes": "断明日必获财，果于次日辰日得财；断语仅言得财无具体财物数额；明日应期合。"}
{"anon_id": "NB-037", "direction": 2, "claims": 2, "timing": 2, "total": 6, "pass": true, "notes": "断出亥日见官府且财利如心，果于出空之日见官财利得意，见官得利与日期俱合。"}
{"anon_id": "NB-038", "direction": 2, "claims": 1, "timing": 2, "total": 5, "pass": true, "notes": "断明日辰日必得，果于辰日得之；断语仅言得财无具体内容；辰日应期合。"}
{"anon_id": "NB-039", "direction": 2, "claims": 2, "timing": 2, "total": 6, "pass": true, "notes": "断今日巳午时切不可斗，果早胜而午时大败破财，败时与破财俱合。"}
{"anon_id": "NB-040", "direction": 2, "claims": 2, "timing": 2, "total": 6, "pass": true, "notes": "断明日出空求之必允，果次日巳时允婚且夫妻白头，允婚与次日时点俱合。"}
{"anon_id": "NB-041", "direction": 1, "claims": 1, "timing": 1, "total": 3, "pass": false, "notes": "断婚必成终有他变，实际仅聘定未及成婚即被贼兵劫去，成婚未成而变故合；无月份预断，无时点可核（中性记 1）。"}
{"anon_id": "NB-042", "direction": 2, "claims": 2, "timing": 1, "total": 5, "pass": true, "notes": "断夫有外遇且必生离，果次年休妻后娶彼妇，外遇与生离俱合；大师未预告休妻月份，无时点可核（中性记 1）。"}
{"anon_id": "NB-043", "direction": 1, "claims": 1, "timing": 1, "total": 3, "pass": false, "notes": "明断无子而嘱积阴德，后果行善连生二子，无子本断被现实反转、仅改命之嘱部分成立；无应期，无时点可核（中性记 1）。"}
{"anon_id": "NB-044", "direction": 2, "claims": 2, "timing": 1, "total": 5, "pass": true, "notes": "断阳动变阴必主女，果生女且产母平安，性别断语合；大师未预告壬申日，无时点可核（中性记 1）。"}
{"anon_id": "NB-045", "direction": 2, "claims": 1, "timing": 2, "total": 5, "pass": true, "notes": "断今日必到，果于今日申时到；断语仅言到达无具体人事情形；今日应期合。"}
{"anon_id": "NB-046", "direction": 2, "claims": 2, "timing": 2, "total": 6, "pass": true, "notes": "断夫不往他处、不日必回且巳日到，果于巳日到，归否与日期俱合。"}
{"anon_id": "NB-047", "direction": 2, "claims": 2, "timing": 2, "total": 6, "pass": true, "notes": "断近病出空即愈而恐难过午年，果出空日愈、午年出花而死，愈与死及两时点俱合。"}
{"anon_id": "NB-048", "direction": 2, "claims": 1, "timing": 2, "total": 5, "pass": true, "notes": "断令郎今日即愈，果于本日愈；断语仅言痊愈无具体症候；今日应期合。"}
{"anon_id": "NB-049", "direction": 2, "claims": 2, "timing": 2, "total": 6, "pass": true, "notes": "断父病莫服药明日辰日冲空即愈，果次日不药而愈，戒药与次日俱合。"}
{"anon_id": "NB-050", "direction": 2, "claims": 1, "timing": 2, "total": 5, "pass": true, "notes": "断此医不可用巳日必添灾，果巳日忽变症遍身疼痛，添灾与巳日合；断语未预言痛症之形，故部分具体。"}
{"anon_id": "NB-051", "direction": 2, "claims": 1, "timing": 1, "total": 4, "pass": true, "notes": "升任之向果验，然断未年高升而实际申年升任，年尺度对而坐标偏一年，为部分对齐。"}
{"anon_id": "NB-052", "direction": 2, "claims": 1, "timing": 1, "total": 4, "pass": true, "notes": "断不宜附葬后果腰疼欲死、安坟而愈且终有迁改后子年迁冢合葬他处；迁改未预告年份，无时点可核（中性记 1）。"}
{"anon_id": "NB-053", "direction": 2, "claims": 2, "timing": 2, "total": 6, "pass": true, "notes": "断辰月妻有大厄难逃，果三月即辰月妻去世，妻厄与月份俱合。"}
{"anon_id": "NB-054", "direction": 2, "claims": 1, "timing": 1, "total": 4, "pass": true, "notes": "断次日必愈方向合，结局言先愈一日应甲寅日，应期有一日坐标偏差为部分对齐；断语仅言痊愈。"}
{"anon_id": "NB-055", "direction": 2, "claims": 2, "timing": 2, "total": 6, "pass": true, "notes": "断旬内不死须防乙酉日，果于乙酉日卯时而死，死与日期俱合。"}
{"anon_id": "NB-056", "direction": 2, "claims": 1, "timing": 0, "total": 3, "pass": false, "notes": "断尸首在大水中，果浮起得见合水位；然断庚申可见而庚申不见、迟至丑月壬申始见，应期不对齐。"}
{"anon_id": "NB-057", "direction": 2, "claims": 2, "timing": 2, "total": 6, "pass": true, "notes": "断辛亥日得大雨，果其日得雨五寸，雨量大与日期俱合。"}
{"anon_id": "NB-058", "direction": 2, "claims": 2, "timing": 2, "total": 6, "pass": true, "notes": "断巳年必然食禄，果巳年得县缺，有官之事与年份俱合。"}
{"anon_id": "NB-059", "direction": 2, "claims": 2, "timing": 1, "total": 5, "pass": true, "notes": "断急归而子已死，果有人报令郎申时已去世，子死合；大师未预告申时，无时点可核（中性记 1）。"}
{"anon_id": "NB-060", "direction": 2, "claims": 1, "timing": 1, "total": 4, "pass": true, "notes": "断惟防损子，果迁屋半月内子出花而死，损子合；断语未言出花之症且无时限预告，无时点可核（中性记 1）。"}
{"anon_id": "NB-061", "direction": 2, "claims": 1, "timing": 1, "total": 4, "pass": true, "notes": "断房中藏神像作祟，果有观音轴藏置、送寺病愈，藏像合而断房中实厨中部位错位；无应期，无时点可核（中性记 1）。"}
{"anon_id": "NB-062", "direction": 2, "claims": 2, "timing": 2, "total": 6, "pass": true, "notes": "断今秋折桂来春占鳌头，果登乡榜次岁联捷，科名两级与秋春时序俱合。"}
{"anon_id": "NB-063", "direction": 2, "claims": 1, "timing": 2, "total": 5, "pass": true, "notes": "断辰月可见煤，果次年清明后即辰月内始得见煤；断语仅言见煤无具体煤况；辰月应期合。"}
{"anon_id": "NB-064", "direction": 2, "claims": 1, "timing": 2, "total": 5, "pass": true, "notes": "断月内辰日得财，果甲辰日巳时到手；断语仅言得财无具体财物；辰日应期合。"}
{"anon_id": "NB-065", "direction": 2, "claims": 2, "timing": 2, "total": 6, "pass": true, "notes": "断来岁辰年可升且反吟去而复来，果辰年调河南五月调回十月升，一年两调一升与年份俱合。"}
