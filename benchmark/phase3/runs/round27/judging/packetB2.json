ion": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "史实：段祺瑞三任国务总理、1924-1926任临时执政（韦书成于1963年，「未执政」一语与史实不合，疑指其执政不稳/未久安，或版本文字之异——本数据集如实标为已知偏差点）；1918-1920确为其权势黄金期，与韦断三年相合；1936年卒"}, {"anon_id": "P3-decd8048", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "网友后回报：经医院检查其母为胃癌初期，因发现早，手术效果不错，正在恢复（论坛帖内反馈，二手）"}, {"anon_id": "P3-e001ab30", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "果于午年午月到家．"}, {"anon_id": "P3-e193f899", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "Joe Biden defeated Donald Trump (306 electoral votes) and was inaugurated on 20 January 2021."}, {"anon_id": "P3-e254e9a9", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "後果買馬七十餘匹﹐一路多死﹐僅存二十八匹﹐幸而得價不然大虧其本。"}, {"anon_id": "P3-e3104265", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "柯文哲2018年以3,254票险胜连任；2024年总统大选得票第三落选；2024年8-9月因京华城案遭羈押禁见（『出事情』一节与之对应，属宽泛断语、对应关系由媒体提出）。前两项核心断言应验"}, {"anon_id": "P3-e35cfc7f", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "'and indeed the Horse did come home three dayes after, and had been full West. However, I judged the Horse would have been at home a day sooner' — recovery and direction as judged, timing one day later than judged; the horse came home Wednesday or Thursday the 13th or 14th of January, 'and it was very true' of those who rode him away."}, {"anon_id": "P3-e36e39a3", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "卽於壬寅日得差﹐次年三月死於中途﹐"}, {"anon_id": "P3-e38e891c", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "果於本月聞由江西升任山東，未及一載，復任江西"}, {"anon_id": "P3-e3db4a2d", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "后于子日成就，盖文书旺于子，且冲破午胎也。"}, {"anon_id": "P3-e5a36310", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "果得于甲午日"}, {"anon_id": "P3-e6cb2815", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "史实：俞鸿钧官至行政院长、上海市长、中央银行总裁；1960年卒"}, {"anon_id": "P3-e80b8501", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "果先愈一日，應甲寅日也"}, {"anon_id": "P3-e8942fa4", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "果於酉日天變﹐戌日而雨﹐"}, {"anon_id": "P3-ea7a9fca", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "直至戊寅年甲子月癸卯日故。此年正值甲戌旬，父临岁旬空内，又绝于岁建，死于月建，胎于日建，元神又被寅年卯日相伤，故当终命也。"}, {"anon_id": "P3-eb7f4c8c", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "其人病起正月，至四月癸卯日故。谓世爻病于寅，绝于巳，死于卯也。何以不于辛卯，而在癸卯，谓癸水克丙火，卯木克戌土，故应于此日也。"}, {"anon_id": "P3-eb8313a2", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "彼回即领家眷往东去，后来覆我曰平安，惟其弟牵念父母往探之，行至半途遭害矣．"}, {"anon_id": "P3-ebd7998a", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "后因官府掣签得缺，近于贼营辞而不去，及至官府去后又因他事而去，至七月城破与官府一同被害，"}, {"anon_id": "P3-ec0ebe75", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "特朗普获胜且优势明确（312对226选举人票，并赢得普选票），并非「极小差距」惜败格局"}, {"anon_id": "P3-ee03434b", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "後蒙恩免死。"}, {"anon_id": "P3-ee22fc34", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "果於次年六月父子相逢。"}, {"anon_id": "P3-ee96ce41", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "特朗普当选第47任总统，选举人票312张（非299张）——胜负方向命中，票数估计偏差13张"}, {"anon_id": "P3-eeec7f6a", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "林郑月娥（女性）于2017-03-26以777票当选第五任香港特首，为香港首位女性特首"}, {"anon_id": "P3-f00ac16e", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "果於八月其子驚風﹐又來卜之。 果死於卯日。夫應於卯日者﹐乃實破之日也。"}, {"anon_id": "P3-f02c4b23", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "Biden won both the popular vote (81.3M to 74.2M) and the Electoral College, was inaugurated on 20 January 2021 and served a full four-year term. The result was contested by Trump supporters but upheld by the courts; the US did not fall apart."}, {"anon_id": "P3-f107fbc7", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "彼曰﹕果有金弟屬猴﹐克曾功一第﹐餘三人皆從別業﹐可見數之責驗如此﹐後一年又登申榜。"}, {"anon_id": "P3-f22d581a", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "果於子時退災﹐次日起牀﹐"}, {"anon_id": "P3-f367a33c", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "果於次年三月妹至"}, {"anon_id": "P3-f3d4dd37", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "「果然应验」——当晚雨停，音乐会得以举办（书内自述，无气象记录佐证）"}, {"anon_id": "P3-f438b568", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "后果削职．"}, {"anon_id": "P3-f4882032", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "Eastward: '(and so he did)'; the obscure night: '(so he did)'; 'The truth is, the Friday after, he had a Letter where he was, and the Sunday after apprehended him again by authority.'"}, {"anon_id": "P3-f5175d75", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "后题而果不准行．"}, {"anon_id": "P3-f5b6ef16", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "Confirmed in the 1852 edition's wording: 'Upon the Friday following he came home, and said he had been at Kingston upon Thames; which if true, then he was full West, or a little to the South, and near a great Water, viz. the Thames.'"}, {"anon_id": "P3-f60617bb", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "蔡英文赢得党内初选、成为候选人并以817万票大胜韩国瑜"}, {"anon_id": "P3-f677ff39", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "刘澄如为南浔「四象」级丝商巨富之后，以富有著称，无显赫官位，与「不贵而极富」之断相合。"}, {"anon_id": "P3-f6802f70", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "捱至七月初七﹐又得凶夢﹐初八卽往東行二十八里﹐地震房塌﹐人口被傷﹐獨伊得免。"}, {"anon_id": "P3-f8698797", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "果於三月升任云南太守，卽升者乃因爻得水局生扶，應三月者辰土出空之月也，應云南者，世與官星皆在六爻之故耳。"}, {"anon_id": "P3-f88f2608", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "後果取超等補稟。"}, {"anon_id": "P3-f8901c17", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "果於申日文書實收俱到﹐"}, {"anon_id": "P3-f8ec379a", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "史实：李鸿章官至直隶总督兼北洋大臣、文华殿大学士，位极人臣，为晚清第一重臣；1901年卒于北京——与崇祯同格不同命的对勘成立"}, {"anon_id": "P3-f90de403", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "后果然（儿妇妊性别如断），澹宁壬午春死。当年脱险、儿妇生男生女、壬午春卒三项均见原文应验记载。"}, {"anon_id": "P3-f9eed854", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "「果被妇人引祸及已」——其人果然因妇人招致祸事及身。"}, {"anon_id": "P3-fa8095da", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "果於酉時霧散天開。"}, {"anon_id": "P3-fac9c047", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "果卒於卯日（應卯日者，沖去原神、忌神共來克害）"}, {"anon_id": "P3-fae20b3f", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "果卒於丑月。"}, {"anon_id": "P3-fe5c894b", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "陆荣廷为旧桂系首领，历任广西都督、两广巡阅使，1924年下野，1928年卒于苏州。其一生确居一方之首，与「极等之贵」的定性相合。"}, {"anon_id": "P3-ff855d00", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "后因裁他处缺上台，题留他处官顶此公位将，此将公赴京另补"}, {"anon_id": "P3-ffa2d1e0", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "果一日陰雲申時而見日色﹐次日卯時大晴。"}, {"anon_id": "P3-ffb40d7c", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "史量才1934年11月13日在沪杭道上遇刺身亡，震动全国。其报业地位正合「无冕帝王」之喻，结局为遇刺，与断语相合。"}]