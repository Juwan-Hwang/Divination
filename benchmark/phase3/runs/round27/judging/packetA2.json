[{"anon_id": "P3-4b529a55", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "史实：哈同（Silas Hardoon）白手起家成为上海地产大王；终身无亲生子女，靠收养义子义女，死后遗产诉讼满城风雨——与韦断相合；1931年卒于上海"}, {"anon_id": "P3-4b8ef72f", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "其家如言掘之，果得金，葬事得办。应验句独立（「其家如言，果得金」）。"}, {"anon_id": "P3-4b9f6a58", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "果於本日酉時遇名醫救活也，至己亥日以全生。"}, {"anon_id": "P3-4ba4235b", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "果然如是。"}, {"anon_id": "P3-4bedfc59", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "杨秀琼1930年代为全国泳坛冠军；1937年（丁丑）与陶伯龄结婚，与「关睢之兆」相合；后移居香港、北美，晚景飘零，1982年卒于温哥华。"}, {"anon_id": "P3-50efa2c7", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "Confirmed in the text: the parson 'being covetous would proceed further... and when he thought to have the matter absolutely on his side, behold, a scurvy Letter, revealing some manifest truths concerning a Female, dashed the good Man's hopes' — he never discovered which neighbour had affronted him."}, {"anon_id": "P3-50f17467", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "果於巳日到。或曰﹕用爻有病﹐莫問歸期﹐此卦申金化進神以克寅木﹐如何許回﹖予曰﹕彼問夫之平安﹐卽以不利斷之﹐今加往他處去否﹐夫爻受到制﹐不往他鄕﹐斷卦者各有取用耳。"}, {"anon_id": "P3-51104511", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "颜惠庆1933年（癸酉）出任驻苏联大使，与断语所指年份、职务相合；后任驻美大使等职，1950年卒于上海。"}, {"anon_id": "P3-5322e6ca", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "「至正月，果被原主回赎」——至正月，其田果被原主赎回。"}, {"anon_id": "P3-534ad722", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "後果於七月﹐先得瀉疾﹐略好後﹐因服補藥太過﹐喫一次藥﹐只能喝一兩水﹐後竟渴死。"}, {"anon_id": "P3-539068ee", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "此人未到家，一人報曰：令郎申時去世矣"}, {"anon_id": "P3-53fa8bce", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "蔡英文参选并以817万票史上最高票连任，民进党同时保住立法院过半"}, {"anon_id": "P3-54a59ae7", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "果於本年下獄至申年而重刑。"}, {"anon_id": "P3-54d9d9b7", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "果于木日死也。"}, {"anon_id": "P3-55096d9d", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "果於次日卯時，雲開日出"}, {"anon_id": "P3-551eeb74", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "果於次年辰月蒙赦而出。"}, {"anon_id": "P3-55d8ca79", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "果不久病愈；九月妻死"}, {"anon_id": "P3-563b4275", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "果于本日巳时还一半，乙酉日巳时还清一半者．"}, {"anon_id": "P3-56b72753", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "果於次日大愈"}, {"anon_id": "P3-5721dfe1", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "果於巳年得縣缺"}, {"anon_id": "P3-5839b8e9", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "此人果死于卯年卯月卯日卯时，应卯日时者，生助午火克冲原神也．"}, {"anon_id": "P3-5863a139", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "後果於寅年醫好富翁﹐厚贈讀書。午年一榜﹐富翁及親友又贈﹐援例縣令﹐未幾丁艱﹐及至補缺未幾﹐裏誤而歸﹐囊筐消然。應寅年者﹐寅年而實空。應午年發者﹐世爻而值年月﹐功名反覆而不久者﹐六沖之卦也。宦囊消索者﹐子水財爻絕於日也﹔"}, {"anon_id": "P3-59815efb", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "果於六月疾至，八月夥計盜盡。鳴之於官，分文不復。"}, {"anon_id": "P3-59c3ee54", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "「后将插莳，果为阴人少财而去，逾三四日，而天则亢旱难用矣」——插莳之时果因（雇工/阴人）少财而去，逾三四日天大旱至于难用。"}, {"anon_id": "P3-5a1e568c", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "後此人屢次遇兵變﹐或避之﹐或有驚無險﹐"}, {"anon_id": "P3-5babcdff", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "果得於辰日（辰土出空之日）"}, {"anon_id": "P3-5bec0311", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "一一皆是，葬后未出三年，二子皆发科甲．"}, {"anon_id": "P3-5e4a462a", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "虞洽卿为上海总商会会长级闻人，抗战期间赴渝，1945年卒于重庆，终年78岁。"}, {"anon_id": "P3-5f484eac", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "此人自二十五歲至五十多歲東奔西走﹐一事無成﹐後因貧困﹐從戒外出。"}, {"anon_id": "P3-5f8dc02c", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "申新系统危机后虽经整顿存续，荣宗敬本人于1938年卒于上海，其事业在其生前未再现「大振旗鼓」之势——断语的近期乐观断言与结局仅部分相合。"}, {"anon_id": "P3-6146e392", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "果于己酉日回也。"}, {"anon_id": "P3-61be843f", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "後應申月所請準﹐酉歲迎靈而歸﹐"}, {"anon_id": "P3-620cbc18", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "果於巳年被論﹐宦囊消索。"}, {"anon_id": "P3-623f0f4f", "prediction": {"direction": null, "assertions": null, "timing": null, "summary": null}, "outcome_record": "后此人往返三次俱得倍利．"}, {"anon_i