{"id": "YM-002", "outcome_record": "后至酉月丁亥日，其病不治。", "tradition": "liuyao", "contamination": "low", "source_tier": "expansion8-yimao"}
{"id": "YM-003", "outcome_record": "后逢亥令解组。", "tradition": "liuyao", "contamination": "low", "source_tier": "expansion8-yimao"}
{"id": "YM-004", "outcome_record": "后至亥令而痊。", "tradition": "liuyao", "contamination": "low", "source_tier": "expansion8-yimao"}
{"id": "YM-005", "outcome_record": "孟春反应迁级。", "tradition": "liuyao", "contamination": "low", "source_tier": "expansion8-yimao"}
{"id": "YM-007", "outcome_record": "（亥月甲辰日）子孙反得平安而归。", "tradition": "liuyao", "contamination": "low", "source_tier": "expansion8-yimao"}
{"id": "YM-008", "outcome_record": "（次年孟夏考）得上上卷。", "tradition": "liuyao", "contamination": "low", "source_tier": "expansion8-yimao"}
{"id": "YM-009", "outcome_record": "在癸亥日摇会，反不得。", "tradition": "liuyao", "contamination": "low", "source_tier": "expansion8-yimao"}
{"id": "YM-010", "outcome_record": "至次日申时方产。", "tradition": "liuyao", "contamination": "low", "source_tier": "expansion8-yimao"}
{"id": "YM-012", "outcome_record": "而当日甲子即归。", "tradition": "liuyao", "contamination": "low", "source_tier": "expansion8-yimao"}
{"id": "YM-013", "outcome_record": "后待丙子日而死。", "tradition": "liuyao", "contamination": "low", "source_tier": "expansion8-yimao"}
{"id": "YM-014", "outcome_record": "至甲午日而回禄，以夏至后先壬而后甲也。", "tradition": "liuyao", "contamination": "low", "source_tier": "expansion8-yimao"}
{"id": "YM-015", "outcome_record": "改丙戌而发乡科。", "tradition": "liuyao", "contamination": "low", "source_tier": "expansion8-yimao"}
{"id": "YM-017", "outcome_record": "壬申日而会友。", "tradition": "liuyao", "contamination": "low", "source_tier": "expansion8-yimao"}
{"id": "YM-018", "outcome_record": "丁卯日（子）至。", "tradition": "liuyao", "contamination": "low", "source_tier": "expansion8-yimao"}
{"id": "YM-019", "outcome_record": "及后二家皆得偕，此占不成。", "tradition": "liuyao", "contamination": "low", "source_tier": "expansion8-yimao"}
{"id": "YM-020", "outcome_record": "后五月妻亡，夫亦继亡。", "tradition": "liuyao", "contamination": "low", "source_tier": "expansion8-yimao"}
{"id": "YM-022", "outcome_record": "后戊子季秋为贼所杀。", "tradition": "liuyao", "contamination": "low", "source_tier": "expansion8-yimao"}
{"id": "YM-023", "outcome_record": "后甲午榜中式（辛卯年是岁失利）。", "tradition": "liuyao", "contamination": "low", "source_tier": "expansion8-yimao"}
{"id": "YM-024", "outcome_record": "雨至己酉日方霁。", "tradition": "liuyao", "contamination": "low", "source_tier": "expansion8-yimao"}
{"id": "YM-025", "outcome_record": "次日大雨。", "tradition": "liuyao", "contamination": "low", "source_tier": "expansion8-yimao"}
{"id": "YM-027", "outcome_record": "及丙申日而后大晴。", "tradition": "liuyao", "contamination": "low", "source_tier": "expansion8-yimao"}
{"id": "YM-028", "outcome_record": "及后辛卯五月始得，九月葬于朱村。", "tradition": "liuyao", "contamination": "low", "source_tier": "expansion8-yimao"}
{"id": "YM-029", "outcome_record": "本岁不得，至来春正月，就地于南山。", "tradition": "liuyao", "contamination": "low", "source_tier": "expansion8-yimao"}
{"id": "YM-030", "outcome_record": "败血三日后复完胎。", "tradition": "liuyao", "contamination": "low", "source_tier": "expansion8-yimao"}
{"id": "YM-032", "outcome_record": "后应生男不育。", "tradition": "liuyao", "contamination": "low", "source_tier": "expansion8-yimao"}
{"id": "YM-033", "outcome_record": "及子寅年连生二男，岂非盛德格天之报。", "tradition": "liuyao", "contamination": "low", "source_tier": "expansion8-yimao"}
{"id": "YM-034", "outcome_record": "当日见标。", "tradition": "liuyao", "contamination": "low", "source_tier": "expansion8-yimao"}
{"id": "YM-035", "outcome_record": "及次年二月始痘。", "tradition": "liuyao", "contamination": "low", "source_tier": "expansion8-yimao"}
{"id": "YM-037", "outcome_record": "于戊申日乃变脾病而不治。", "tradition": "liuyao", "contamination": "low", "source_tier": "expansion8-yimao"}
{"id": "YM-038", "outcome_record": "后其疾不死，未半年溺水而亡。", "tradition": "liuyao", "contamination": "low", "source_tier": "expansion8-yimao"}
{"id": "YM-039", "outcome_record": "遂亡本月。", "tradition": "liuyao", "contamination": "low", "source_tier": "expansion8-yimao"}
{"id": "YM-040", "outcome_record": "后病得起。", "tradition": "liuyao", "contamination": "low", "source_tier": "expansion8-yimao"}
{"id": "YM-042", "outcome_record": "当月病愈。", "tradition": "liuyao", "contamination": "low", "source_tier": "expansion8-yimao"}
{"id": "YM-043", "outcome_record": "（化绝于亥）遂不救。", "tradition": "liuyao", "contamination": "low", "source_tier": "expansion8-yimao"}
{"id": "YM-044", "outcome_record": "及冬病愈。", "tradition": "liuyao", "contamination": "low", "source_tier": "expansion8-yimao"}
{"id": "YM-045", "outcome_record": "后交子月壬辰日，病势渐解。", "tradition": "liuyao", "contamination": "low", "source_tier": "expansion8-yimao"}
{"id": "YM-047", "outcome_record": "及癸亥日而亡。", "tradition": "liuyao", "contamination": "low", "source_tier": "expansion8-yimao"}
{"id": "YM-048", "outcome_record": "至下岁孟春方绝。", "tradition": "liuyao", "contamination": "low", "source_tier": "expansion8-yimao"}
{"id": "YM-049", "outcome_record": "是夕遂卒。", "tradition": "liuyao", "contamination": "low", "source_tier": "expansion8-yimao"}
{"id": "YM-050", "outcome_record": "卯月病愈。", "tradition": "liuyao", "contamination": "low", "source_tier": "expansion8-yimao"}
{"id": "YM-052", "outcome_record": "虽危不死，及冬而愈。", "tradition": "liuyao", "contamination": "low", "source_tier": "expansion8-yimao"}
{"id": "YM-053", "outcome_record": "其女不死；中男相继而病，及甲申旬中男反亡。", "tradition": "liuyao", "contamination": "low", "source_tier": "expansion8-yimao"}
{"id": "YM-054", "outcome_record": "次女无事；其后少男亦痘。", "tradition": "liuyao", "contamination": "low", "source_tier": "expansion8-yimao"}
{"id": "YM-055", "outcome_record": "丑年发甲是也。", "tradition": "liuyao", "contamination": "low", "source_tier": "expansion8-yimao"}
{"id": "YM-057", "outcome_record": "季冬始升是也。", "tradition": "liuyao", "contamination": "low", "source_tier": "expansion8-yimao"}
{"id": "YM-058", "outcome_record": "后应擢河南中土。", "tradition": "liuyao", "contamination": "low", "source_tier": "expansion8-yimao"}
{"id": "YM-059", "outcome_record": "后擢齐地分野。", "tradition": "liuyao", "contamination": "low", "source_tier": "expansion8-yimao"}
{"id": "YM-060", "outcome_record": "后擢西北。", "tradition": "liuyao", "contamination": "low", "source_tier": "expansion8-yimao"}
{"id": "YM-062", "outcome_record": "其后午月方获。", "tradition": "liuyao", "contamination": "low", "source_tier": "expansion8-yimao"}
{"id": "YM-063", "outcome_record": "后遇丁丑，冲动未爻，其弟乃还。", "tradition": "liuyao", "contamination": "low", "source_tier": "expansion8-yimao"}
{"id": "YM-064", "outcome_record": "是日乃至。", "tradition": "liuyao", "contamination": "low", "source_tier": "expansion8-yimao"}
{"id": "YM-065", "outcome_record": "后及甲寅日乃至。", "tradition": "liuyao", "contamination": "low", "source_tier": "expansion8-yimao"}
{"id": "YM-067", "outcome_record": "次日乙卯，冲实用神，是辰乃至。", "tradition": "liuyao", "contamination": "low", "source_tier": "expansion8-yimao"}
{"id": "YM-068", "outcome_record": "而不知已堕于井。", "tradition": "liuyao", "contamination": "low", "source_tier": "expansion8-yimao"}
{"id": "YM-069", "outcome_record": "而不知相遇于岳家。", "tradition": "liuyao", "contamination": "low", "source_tier": "expansion8-yimao"}
{"id": "YM-070", "outcome_record": "后果同行都下。", "tradition": "liuyao", "contamination": "low", "source_tier": "expansion8-yimao"}
{"id": "DT-001", "outcome_record": "以后果无事（父病无事）。", "tradition": "liuyao", "contamination": "medium", "source_tier": "expansion8-duanyi-tianji"}
{"id": "DT-002", "outcome_record": "后果于九月己卯日巳时生男，母子俱得平安。", "tradition": "liuyao", "contamination": "medium", "source_tier": "expansion8-duanyi-tianji"}
{"id": "DT-003", "outcome_record": "其人果死不还。", "tradition": "liuyao", "contamination": "medium", "source_tier": "expansion8-duanyi-tianji"}
{"id": "DT-004", "outcome_record": "其子果死（原文作『其子果死不救』）。", "tradition": "liuyao", "contamination": "medium", "source_tier": "expansion8-duanyi-tianji"}
{"id": "DT-005", "outcome_record": "果然无事（子病无事）。", "tradition": "liuyao", "contamination": "medium", "source_tier": "expansion8-duanyi-tianji"}
{"id": "DT-006", "outcome_record": "果然无事（子病无事）。", "tradition": "liuyao", "contamination": "medium", "source_tier": "expansion8-duanyi-tianji"}
{"id": "DT-007", "outcome_record": "后果二月壬辰日，贼果来偷其家财。", "tradition": "liuyao", "contamination": "medium", "source_tier": "expansion8-duanyi-tianji"}
{"id": "LR3-002", "outcome_record": "断尾自载应验：仅撤回剿贼；庚辰太岁受克、退位俱验。撤回事与庚辰退位两项均以确指事件/时点表述，附于断语之末（同 LR2-024 短承口径）。", "tradition": "liuren", "contamination": "low", "source_tier": "expansion9-liuren-chen1"}
{"id": "LR3-004", "outcome_record": "后历任通州，擢南大司农、大司马，请告归里。历官之地（通州）与所历之职（南大司农、大司马）及最终请告归里均载原文应验段。", "tradition": "liuren", "contamination": "low", "source_tier": "expansion9-liuren-chen1"}
{"id": "LR3-006", "outcome_record": "月内升天津巡抚，后以标官劫皇销事发，请告回里。荣转之职（天津巡抚）、退位之由（标官劫皇销事发请告）均载原文应验段。", "tradition": "liuren", "contamination": "low", "source_tier": "expansion9-liuren-chen1"}
{"id": "LR3-008", "outcome_record": "起官一项原文以「后果然」短承；次年冬，推补兵部车驾司。得职之时点（次年冬）与职名（兵部车驾司）具体载于原文应验段。", "tradition": "liuren", "contamination": "low", "source_tier": "expansion9-liuren-chen1"}
{"id": "LR3-010", "outcome_record": "后知为四明讳象坤钱相公所占。果因人言请告而去。所占之人于应验段揭明为钱象坤，去位方式（因人言请告而去）与断语对应。", "tradition": "liuren", "contamination": "low", "source_tier": "expansion9-liuren-chen1"}
{"id": "LR3-101", "outcome_record": "后补刑部主政，恬退不仕。补刑部主政一节证其已中式入仕，与「必中」对应；「恬退不仕」与「居官未能远大」对应。同课旁载的代占会武中两名、占病死二人系一课多占的旁验，不属本例结局。", "tradition": "liuren", "contamination": "low", "source_tier": "expansion9-liuren-chen2"}
{"id": "LR3-104", "outcome_record": "后果以上章荐人，下狱拟配。上疏后下狱拟配，与「得罪君相、于公不利」对应。", "tradition": "liuren", "contamination": "low", "source_tier": "expansion9-liuren-chen2"}
{"id": "LR3-107", "outcome_record": "后知为荆州知府王承曾，甲戌进士，以失城逮问，贼破燕京始出。科第（甲戌进士）、王姓、荆州知府、以失城逮问（获罪朝廷）、京破始出（无大咎得脱）均于应验段揭明。", "tradition": "liuren", "contamination": "low", "source_tier": "expansion9-liuren-chen2"}
{"id": "LR3-110", "outcome_record": "果后三日自刘家集寻得。后三日在刘家集寻得，与「三日内必获」对应（马色与西北方位两项原文未另逐字复核，评分时按未复核处理）。", "tradition": "liuren", "contamination": "low", "source_tier": "expansion9-liuren-chen2"}
{"id": "LR3-112", "outcome_record": "果后三月一贼入室，刘复来言及（「防贼至」应验）。后贼果被获，及询其姓名，则陈忠也（陈姓一节应验；年少、独行、告官三日获等细项原文未逐项复核）。病断（甲戌年不保）原文未载应验。", "tradition": "liuren", "contamination": "low", "source_tier": "expansion9-liuren-chen2"}
{"id": "LR3-114", "outcome_record": "其时亥时右邻木客已被劫（邻人被劫一节当场证实）；果次日北关门外行劫，遂获二名。贼劫邻人、复出作案被获均具体；惟获期为次日而非五日后、获二名而非八九人全获，应期与人数两项按部分合处理。", "tradition": "liuren", "contamination": "low", "source_tier": "expansion9-liuren-chen2"}
{"id": "LR3-116", "outcome_record": "范大服，开帨视之，是牛黄二块，每块约重四分七八厘。二件、黄黑（牛黄）、贵重药材、每块四分七八厘与断语逐项对应（注解本作「石黄二块」，断语/应验以原书本「牛黄」为准，异文在此注明）。", "tradition": "liuren", "contamination": "low", "source_tier": "expansion9-liuren-chen2"}
